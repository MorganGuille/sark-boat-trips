{
  "name": "sark-boat-trips",
  "version": "1.0.0",
  "description": "Sark Boat Trips — server + client deployment",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "build": "cd client && npm install && npm run build",
    "dev:server": "cd server && node --watch index.js",
    "dev:client": "cd client && npm run dev",
    "heroku-postbuild": "npm run build",
    "lint": "cd client && npm run lint",
    "test": "node server/test/prepare.js && node --test --test-concurrency=4 \"server/test/**/*.test.js\"",
    "test:e2e": "playwright test --config e2e/playwright.config.js",
    "backup": "cd server && node scripts/backup.js",
    "restore": "cd server && node scripts/restore.js",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "engines": {
    "node": "22.11.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6",
      "disablePostinstall": "1"
    }
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.20.4",
    "nodemailer": "^7.0.12",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
