# Copy this file to server/.env and fill in the values. Never commit the real .env file.
# Settings marked (production) must be set on the host (for Heroku: heroku config:set NAME=value).

PORT=4040

# Dashboard login. Make the hash with: node server/scripts/hash-password.js
admin_username=
admin_password_hash=
# Long and random, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MongoDB Atlas (use the sandbox database name on a laptop, the real one in production)
atlasDB_name=
# A database user that can only use that one database (Atlas, Database Access, built-in role readWrite).
# Laptop: the sandbox user. Production: its own user. If these two are left out, the server falls back to
# the original shared user and atlasDB_password (production uses that until it has its own user).
atlasDB_user=
atlasDB_user_password=
atlasDB_password=
# Outside production the server refuses to start unless atlasDB_name contains "sandbox".

# Email (see spec P2-10: the free Gmail address is going to be replaced)
gmail_address=
gmail_password=

# Where customers are sent back to after paying, and what the dashboard link in owner emails points at.
# Your laptop: http://localhost:5173    Production: https://www.sarkboattrips.com
PUBLIC_URL=

# Stripe. Every online booking saves a card with Stripe (see paymentsspec.md). Production uses
# STRIPEKEY (live). Anywhere else uses STRIPETESTKEY, and switches online booking off if it only has a
# live key, so a laptop can never charge a real card. Amounts come from the prices set on the
# dashboard, so there is no Stripe price ID to set.
STRIPEKEY=
STRIPETESTKEY=
# The signing secret (whsec_...) of the Stripe webhook endpoint for this environment
STRIPE_WEBHOOK_SECRET=
# true: Stripe's card page asks customers to tick "I agree to the terms". Only switch it on after
# saving the terms address (https://www.sarkboattrips.com/terms) in Stripe: Settings, Business,
# Public details. Without that address Stripe refuses every booking.
# STRIPE_TERMS_CONSENT=true

# Optional: how many proxies sit in front of the app. Heroku, Render, Railway and Fly all have one (the default).
# TRUST_PROXY=1
# NODE_ENV=production is set by Heroku. On any other host you must set it yourself (production only).
